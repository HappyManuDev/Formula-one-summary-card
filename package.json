{
  "name": "formula-one-summary-card",
  "version": "0.1.0",
  "description": "A Home Assistant Lovelace card summarising the Formula 1 season: next Grand Prix, race weekend schedule, results and title fight.",
  "type": "module",
  "module": "dist/formula-one-summary-card.js",
  "license": "MIT",
  "author": "HappyManuDev",
  "repository": {
    "type": "git",
    "url": "https://github.com/HappyManuDev/Formula-one-summary-card.git"
  },
  "bugs": {
    "url": "https://github.com/HappyManuDev/Formula-one-summary-card/issues"
  },
  "homepage": "https://github.com/HappyManuDev/Formula-one-summary-card#readme",
  "keywords": [
    "home-assistant",
    "hacs",
    "lovelace",
    "lovelace-custom-card",
    "formula-1",
    "f1"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --max-warnings 0 --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-wc": "^3.1.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "playwright-core": "^1.65.0",
    "prettier": "^3.9.10",
    "terser": "^5.51.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
